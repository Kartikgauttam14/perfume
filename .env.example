# ============================================================
# Mansam Luxury Fragrance Concierge — Environment Configuration
# ============================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# WhatsApp webhook — set secrets only in Render environment settings
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=1307049029167597
# Point this at an existing Render persistent disk for production durability
WHATSAPP_INBOX_PATH=./data/whatsapp.sqlite3
WHATSAPP_AUTO_REPLY_ENABLED=False
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=shop_now
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_IMAGE_URL=https://ae.mansamworld.com/images/products/480/Safaa_Al_Nada_3.jpg
WHATSAPP_TEMPLATE_IMAGE_ID=

# LLM Provider — OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use — any model available on OpenRouter, e.g.:
#   openai/gpt-4o-mini       (fast, affordable)
#   openai/gpt-4o            (highest quality)
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash
#   meta-llama/llama-3.1-8b-instruct  (free tier)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Data Paths
CHUNKS_FILE_PATH=./mansam_chunks.jsonl
SUMMARY_FILE_PATH=./mansam_chunks_summary.json

# Brand Support Contacts (Defaults from SSOT)
KSA_WHATSAPP=+966539822844
UAE_WHATSAPP=+971544854544
CUSTOMER_SUPPORT_EMAIL=customercare@mansamworld.com
